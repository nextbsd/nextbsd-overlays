# sudo: auth account password session
#
# Darwin's shape (apple-oss-distributions/sudo, pam.d/sudo): local additions go
# in /etc/pam.d/sudo_local, which is not shipped and so survives updates; copy
# sudo_local.template to start one. A missing sudo_local is skipped by OpenPAM.
# Darwin's pam_smartcard/pam_opendirectory lines become the system stack, whose
# pam_unix ... nullok lets an account with no password through without a prompt
# and makes an account with a password type it.
auth		include		sudo_local
auth		sufficient	pam_rootok.so		no_warn
auth		include		system
account		include		system
session		include		system
password	include		system
