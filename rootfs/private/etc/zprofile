# /etc/zprofile -- read by login zsh(1) shells, after /etc/zshenv and
# before /etc/zshrc.
#
# Per-user additions go in ~/.zprofile.

# A UTF-8 locale unless the session already set one.
if [[ -z $LANG ]]; then
	export LANG=C.UTF-8
fi

# The login banner. ZSH_VERSION is not exported by zsh, so pass it for the
# shell line; nextbsd-fetch prints the shell's name alone without it rather
# than guessing. It stays quiet where a login window is installed, where
# ~/.hushlogin exists, and when this is not a terminal.
if [[ -o interactive ]] && [[ -x /usr/bin/nextbsd-fetch ]]; then
	ZSH_VERSION=$ZSH_VERSION /usr/bin/nextbsd-fetch
fi
