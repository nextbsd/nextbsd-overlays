# Opting out, from ~/.zshenv (which zsh reads before this file):
#   NEXTBSD_ZSHRC=no         skip this whole file
#   NEXTBSD_ZSH_PLUGINS=no   skip autosuggestions and syntax highlighting
[[ $NEXTBSD_ZSHRC == no ]] && return

fpath=(/usr/share/zsh/site-functions $fpath)

# Initialize completion system
autoload -Uz compinit && compinit

# A user with no ~/.zshrc gets a working shell, not zsh's first-run setup
# wizard. The user template ships a ~/.zshrc, so this only matters for a home
# that was made some other way; writing one must never be a requirement.
zsh-newuser-install() { : }

ZSH_AUTOSUGGEST_STRATEGY=(match_prev_cmd history completion)

if [[ $NEXTBSD_ZSH_PLUGINS != no ]]; then
	[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
		source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
	# Sourced after the other widgets, as upstream requires. brackets is
	# worth having alongside main: it colours an unbalanced quote or
	# parenthesis, which is the mistake you most want to see before Enter.
	ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)
	[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
		source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Color ls output
export CLICOLOR=1
alias ls='ls --color=auto'

# Use fish-style command history
HISTFILE=~/.zsh_history      # Location of history file
HISTSIZE=10000               # Number of lines kept in memory
SAVEHIST=10000               # Number of lines saved to file

# Options for fish-like behavior
setopt hist_ignore_dups      # Don't record duplicate lines
setopt hist_reduce_blanks    # Remove unnecessary blanks
setopt inc_append_history    # Save each command as soon as it's run
setopt share_history         # Share history across all zsh sessions
setopt extended_history      # Add timestamps to history

# Fish-style up-arrow history search (per command line input)
autoload -Uz up-line-or-beginning-search
autoload -Uz down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search     # Up arrow
bindkey "^[[B" down-line-or-beginning-search   # Down arrow

# Home, End, Delete and the other editing keys, from terminfo so they work on
# the console and over ssh alike. Without these they insert escape sequences.
typeset -g -A key
key=(
	Home      "${terminfo[khome]}"
	End       "${terminfo[kend]}"
	Delete    "${terminfo[kdch1]}"
	Backspace "${terminfo[kbs]}"
	PageUp    "${terminfo[kpp]}"
	PageDown  "${terminfo[knp]}"
)
[[ -n ${key[Home]}      ]] && bindkey -- "${key[Home]}"      beginning-of-line
[[ -n ${key[End]}       ]] && bindkey -- "${key[End]}"       end-of-line
[[ -n ${key[Delete]}    ]] && bindkey -- "${key[Delete]}"    delete-char
[[ -n ${key[Backspace]} ]] && bindkey -- "${key[Backspace]}" backward-delete-char
[[ -n ${key[PageUp]}    ]] && bindkey -- "${key[PageUp]}"    beginning-of-buffer-or-history
[[ -n ${key[PageDown]}  ]] && bindkey -- "${key[PageDown]}"  end-of-buffer-or-history
bindkey -- '^[[1~' beginning-of-line
bindkey -- '^[[4~' end-of-line
bindkey -- '^[[3~' delete-char
bindkey -- '^[[H'  beginning-of-line
bindkey -- '^[[F'  end-of-line

# Load color module
autoload -U colors && colors

# Enable prompt substitution
setopt PROMPT_SUBST

# Use Terminator's 3rd palette color (ANSI 2) for user and path, terminal foreground for host
user_color='2'      # ANSI 2 (Terminator's 3rd color, green)
host_color='fg'     # Terminal's default foreground
path_color='2'      # ANSI 2 (Terminator's 3rd color, green)

# Git info function to show branch info in prompt, with fallback if Git is not installed
function git_info() {
  # Check if Git is installed
  if ! command -v git &>/dev/null; then
    return 1  # Return 1 if Git is not installed
  fi

  # Check if inside a Git repository
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    return 1  # Return 1 if not inside a Git repository
  fi

  # Get the current Git branch or fallback to describe if in detached HEAD
  local branch=$(git symbolic-ref --short HEAD 2>/dev/null)
  if [[ -z "$branch" ]]; then
    branch=$(git describe --tags --always 2>/dev/null)
  fi

  # Return the Git info with the branch or fallback name
  echo "%F{$host_color}($branch)%f"
}

# The username is always shown, and the directory is the full path rather than
# an abbreviation, so what is on screen is what you would type.
PROMPT="%F{$user_color}%n%f@%F{$host_color}%m%f %F{$path_color}%~\$(git_info)%f %# "

# Esc-h on a command opens its man page.
unalias run-help 2>/dev/null
autoload -Uz run-help
alias help=run-help
