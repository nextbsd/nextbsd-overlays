# /etc/zshrc -- NextBSD's profile for interactive zsh(1) shells: prompt,
# history, completion, key bindings, autosuggestions, colours. Root gets it
# too. Every user can override any of it in ~/.zshrc, which zsh reads after
# this file.
#
# Opting out, from ~/.zshenv (which zsh reads before this file):
#   NEXTBSD_ZSH_PLUGINS=no   skip zsh-autosuggestions
#   NEXTBSD_ZSHRC=no         skip this whole file
[[ $NEXTBSD_ZSHRC == no ]] && return

# --- terminal and locale ------------------------------------------------
# Combining characters display correctly in UTF-8 locales.
[[ ${LC_ALL:-${LC_CTYPE:-$LANG}} == (*[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ]] && setopt COMBINING_CHARS

# --- history --------------------------------------------------------------
HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY		# one history across all open shells
setopt HIST_IGNORE_ALL_DUPS	# keep only the latest copy of a command
setopt HIST_IGNORE_SPACE	# a leading space keeps a command out of history
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY		# timestamps and durations

# --- options --------------------------------------------------------------
setopt INTERACTIVE_COMMENTS	# a # comment on the command line
setopt NO_BEEP
setopt NO_FLOW_CONTROL		# ^S and ^Q are keys, not terminal stop/start

# --- key bindings ---------------------------------------------------------
# Emacs keys. The cursor and editing keys come from terminfo so they work
# on the console and over ssh alike; terminals that send them only in
# keypad-transmit mode are switched into it while the line editor runs.
bindkey -e
typeset -g -A key
key=(
	Home      "${terminfo[khome]}"
	End       "${terminfo[kend]}"
	Insert    "${terminfo[kich1]}"
	Delete    "${terminfo[kdch1]}"
	Backspace "${terminfo[kbs]}"
	PageUp    "${terminfo[kpp]}"
	PageDown  "${terminfo[knp]}"
	Up        "${terminfo[kcuu1]}"
	Down      "${terminfo[kcud1]}"
	Left      "${terminfo[kcub1]}"
	Right     "${terminfo[kcuf1]}"
	ShiftTab  "${terminfo[kcbt]}"
)
[[ -n ${key[Home]}      ]] && bindkey -- "${key[Home]}"      beginning-of-line
[[ -n ${key[End]}       ]] && bindkey -- "${key[End]}"       end-of-line
[[ -n ${key[Insert]}    ]] && bindkey -- "${key[Insert]}"    overwrite-mode
[[ -n ${key[Delete]}    ]] && bindkey -- "${key[Delete]}"    delete-char
[[ -n ${key[Backspace]} ]] && bindkey -- "${key[Backspace]}" backward-delete-char
[[ -n ${key[PageUp]}    ]] && bindkey -- "${key[PageUp]}"    beginning-of-buffer-or-history
[[ -n ${key[PageDown]}  ]] && bindkey -- "${key[PageDown]}"  end-of-buffer-or-history
[[ -n ${key[Up]}        ]] && bindkey -- "${key[Up]}"        up-line-or-search
[[ -n ${key[Down]}      ]] && bindkey -- "${key[Down]}"      down-line-or-search
[[ -n ${key[Left]}      ]] && bindkey -- "${key[Left]}"      backward-char
[[ -n ${key[Right]}     ]] && bindkey -- "${key[Right]}"     forward-char
[[ -n ${key[ShiftTab]}  ]] && bindkey -- "${key[ShiftTab]}"  reverse-menu-complete
# The common escape sequences as well, for terminals whose terminfo is off.
bindkey -- '^[[1~' beginning-of-line
bindkey -- '^[[4~' end-of-line
bindkey -- '^[[3~' delete-char
bindkey -- '^[[H'  beginning-of-line
bindkey -- '^[[F'  end-of-line
bindkey -- '^[[1;5C' forward-word	# ctrl-right
bindkey -- '^[[1;5D' backward-word	# ctrl-left
if (( ${+terminfo[smkx]} && ${+terminfo[rmkx]} )); then
	zle-line-init()   { echoti smkx }
	zle-line-finish() { echoti rmkx }
	zle -N zle-line-init
	zle -N zle-line-finish
fi

# --- completion -----------------------------------------------------------
# zsh-completions (nextbsd-contrib) sit in site-functions, ahead of the
# shell's own functions. The compiled dump lives in the user's cache
# directory so startup stays fast.
fpath=(/usr/share/zsh/site-functions $fpath)
typeset -U fpath
_nextbsd_zcache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $_nextbsd_zcache ]] || mkdir -p -- "$_nextbsd_zcache" 2>/dev/null
autoload -Uz compinit
compinit -d "$_nextbsd_zcache/zcompdump-$ZSH_VERSION"
zmodload -i zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path "$_nextbsd_zcache/compcache"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}no matches%f'
zstyle ':completion:*' list-colors ''
unset _nextbsd_zcache

# --- colours and aliases --------------------------------------------------
export CLICOLOR=1				# ls(1) colours on a terminal
: ${LSCOLORS:=exfxcxdxbxegedabagacad}		# Darwin's default
export LSCOLORS
alias ls='ls -F'
alias ll='ls -lhF'
alias la='ls -lhAF'
alias grep='grep --color=auto'

# --- prompt ---------------------------------------------------------------
# user@host dir, with % for a user and # for root, coloured on terminals
# that can. Nothing here runs a command per prompt.
if (( ${terminfo[colors]:-0} >= 8 )); then
	PROMPT='%F{green}%n@%m%f %F{blue}%1~%f %# '
else
	PROMPT='%n@%m %1~ %# '
fi
# Terminal title: user@host: dir, on terminals that take one.
case $TERM in
xterm*|rxvt*|screen*|tmux*|alacritty|foot|wezterm|st-*)
	_nextbsd_title() { print -Pn '\e]0;%n@%m: %~\a' }
	autoload -Uz add-zsh-hook
	add-zsh-hook precmd _nextbsd_title
	;;
esac

# --- zsh-autosuggestions --------------------------------------------------
# Greyed-out completion of the current line from history; accept with
# right-arrow or End. Off with NEXTBSD_ZSH_PLUGINS=no in ~/.zshenv.
if [[ $NEXTBSD_ZSH_PLUGINS != no &&
      -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
	ZSH_AUTOSUGGEST_STRATEGY=(history completion)
	ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=200
	source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# --- run-help -------------------------------------------------------------
# Esc-h on a command opens its man page.
unalias run-help 2>/dev/null
autoload -Uz run-help
alias help=run-help
