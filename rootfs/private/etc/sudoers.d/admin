#
# /etc/sudoers.d/admin: the Darwin sudoers defaults
# (apple-oss-distributions/sudo, sudo-114.100.11, files/sudoers) and the
# admin rule, plus NextBSD's additions and the same rule for wheel.
#
# Neither rule uses NOPASSWD, so sudo authenticates through /etc/pam.d/sudo:
# a user with a password must type it; a user with no password is not
# prompted (pam_unix nullok). Must be owned by root and not group- or
# world-writable.
#

##
# Override built-in defaults
##
Defaults	env_reset
Defaults	env_keep += "BLOCKSIZE"
Defaults	env_keep += "COLORFGBG COLORTERM"
Defaults	env_keep += "__CF_USER_TEXT_ENCODING"
Defaults	env_keep += "CHARSET LANG LANGUAGE LC_ALL LC_COLLATE LC_CTYPE"
Defaults	env_keep += "LC_MESSAGES LC_MONETARY LC_NUMERIC LC_TIME"
Defaults	env_keep += "LINES COLUMNS"
Defaults	env_keep += "LSCOLORS"
Defaults	env_keep += "SSH_AUTH_SOCK"
Defaults	env_keep += "TZ"
Defaults	env_keep += "DISPLAY XAUTHORIZATION XAUTHORITY"
Defaults	env_keep += "EDITOR VISUAL"
Defaults	env_keep += "HOME MAIL"

# No lecture: Darwin sets lecture_file = "/etc/sudo_lecture"; NextBSD shows none.
# lecture = never is required, or sudo falls back to its built-in lecture.
Defaults	lecture = never

##
# NextBSD additions
##
# The domain Library/Tools directories come first, then the base paths, so
# tools under /System, /Local, /Network and root's Library resolve under sudo.
Defaults	secure_path = "/root/Library/Tools:/Local/Library/Tools:/Network/Library/Tools:/System/Library/Tools:/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/libexec:/root/bin"
# Keep the library and GNUstep environment, so GNUstep tools run through sudo
# (and sudo -A from SudoAskPass) find their libraries without sudo -E. LD_* and
# DYLD_* must be named here: sudo strips them otherwise.
Defaults	env_keep += "LD_LIBRARY_PATH DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH"
Defaults	env_keep += "GNUSTEP_MAKEFILES GNUSTEP_USER_ROOT GNUSTEP_LOCAL_ROOT GNUSTEP_NETWORK_ROOT GNUSTEP_SYSTEM_ROOT"
Defaults	env_keep += "LIBRARY_COMBO GNUSTEP_HOST GNUSTEP_HOST_CPU GNUSTEP_HOST_OS GNUSTEP_HOST_VENDOR"

# Remove this line to log successful sudo launches. May contain sensitive
# information passed as arguments to the command
Defaults	!log_allowed

##
# User specification
##
%admin		ALL = (ALL) ALL
%wheel		ALL = (ALL) ALL
